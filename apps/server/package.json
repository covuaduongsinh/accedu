{
  "name": "@accedu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AccEdu Platform server — auth (tương thích supabase-js), realtime WebSocket, API quản trị, CLI migrate",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "cli": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pretest": "bash ../../supabase/scripts/local-pg.sh start"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@node-rs/argon2": "2.2.2",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "vitest": "5.0.5"
  }
}
