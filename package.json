{
  "name": "accedu",
  "private": true,
  "description": "AccEdu — phần mềm kế toán đám mây của Cờ vua Dương Sinh (web, desktop, mobile)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @accedu/web dev",
    "dev:desktop": "pnpm --filter @accedu/desktop dev",
    "dev:mobile": "pnpm --filter @accedu/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "check": "pnpm lint && turbo run typecheck test",
    "db:start": "bash supabase/scripts/local-pg.sh start",
    "db:stop": "bash supabase/scripts/local-pg.sh stop",
    "db:reset": "bash supabase/scripts/local-pg.sh reset",
    "db:test": "pnpm --filter @accedu/db-tests test"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
